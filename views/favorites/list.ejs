<h1><%= title %></h1>

<%- include("../partials/messages") %>

<% if (favorites && favorites.length > 0) { %>
  <div class="favorites-grid">
    <% favorites.forEach(function(vehicle) { %>
      <div class="favorite-item">
        <a href="/inv/detail/<%= vehicle.inv_id %>">
          <img src="<%= vehicle.inv_thumbnail %>" 
               alt="<%= vehicle.inv_make %> <%= vehicle.inv_model %>">
        </a>
        <div class="favorite-info">
          <h3>
            <a href="/inv/detail/<%= vehicle.inv_id %>">
              <%= vehicle.inv_year %> <%= vehicle.inv_make %> <%= vehicle.inv_model %>
            </a>
          </h3>
          <p class="price">$<%= new Intl.NumberFormat('en-US').format(vehicle.inv_price) %></p>
          <p class="classification"><%= vehicle.classification_name %></p>
          
          <form action="/favorites/remove" method="POST" style="display:inline;">
            <input type="hidden" name="inv_id" value="<%= vehicle.inv_id %>">
            <button type="submit" class="btn-remove">Remove from Favorites</button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>
<% } else { %>
  <p class="notice">You haven't added any favorites yet!</p>
  <p><a href="/">Browse our inventory</a> to find vehicles you love.</p>
<% } %>

<style>
  .favorites-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
    margin-top: 20px;
  }
  
  .favorite-item {
    border: 1px solid #ddd;
    padding: 15px;
    border-radius: 8px;
    background: white;
  }
  
  .favorite-item img {
    width: 100%;
    height: auto;
    border-radius: 4px;
  }
  
  .favorite-info h3 {
    margin: 10px 0 5px;
    font-size: 1.2em;
  }
  
  .price {
    color: #2a7ae4;
    font-weight: bold;
    font-size: 1.3em;
    margin: 5px 0;
  }
  
  .classification {
    color: #666;
    font-size: 0.9em;
    margin: 5px 0 10px;
  }
  
  .btn-remove {
    background: #dc3545;
    color: white;
    border: none;
    padding: 8px 15px;
    border-radius: 4px;
    cursor: pointer;
  }
  
  .btn-remove:hover {
    background: #c82333;
  }
</style>